# Copy to .env and change the values. .env is in .gitignore - never commit real passwords.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern
DATABASE_PASSWORD=bitte-aendern
PUBLIC_BASE_URL=http://localhost:5173

# E-mail via SMTP (optional). Leave SPRING_MAIL_HOST empty to only log messages.
# Brevo:  smtp-relay.brevo.com / 587, login + SMTP key from Brevo > SMTP & API
# Gmail:  smtp.gmail.com / 587, your address + an app password (needs 2-step verification)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
